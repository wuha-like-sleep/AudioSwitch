   VALUE "ProductName", "AudioSwitch Login Lab\0"
   VALUE "ProductVersion", "0.3.11-preview.1\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 wuha-like-sleep\0"
  END
 END
 BLOCK "VarFileInfo"
