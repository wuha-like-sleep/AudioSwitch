#include <winver.h>
1 VERSIONINFO
 FILEVERSION 0,3,11,0
 PRODUCTVERSION 0,3,11,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
#ifdef LOGIN_BRIDGE
